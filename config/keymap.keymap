#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC                 &kp N1            &kp N2    &kp N3    &kp N4     &kp N5                                   &kp N6       &kp N7  &kp N8  &kp N9    &kp N0            &kp BSPC
&kp ESC                 &kp Q             &kp L     &kp U     &kp COMMA  &kp PERIOD                               &kp F        &kp W   &kp R   &kp Y     &kp P             &kp SLASH
&kp LEFT_SHIFT          &kp E             &kp I     &kp A     &kp O      &kp MINUS      &mkp LCLK  &mkp RCLK      &kp K        &kp T   &kp N   &kp S     &kp H             &kp SQT
&mt LEFT_CONTROL LANG1  &kp Z             &kp X     &kp C     &kp V      &kp SEMICOLON  &kp SPACE  &kp RET        &kp G        &kp D   &kp M   &kp J     &kp B             &mt RSHFT LANG2
&kp LCTRL               &kp LEFT_CONTROL  &kp LGUI  &kp LALT  &kp DEL    &lt 2 SPACE    &kp TAB    &kp BACKSPACE  &lt 3 ENTER  &trans  &trans  &kp RGUI  &kp LEFT_CONTROL  &kp RCTRL
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &mo 4   &mkp MCLK  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans          &trans          &trans           &trans                  &trans      &trans  &trans  &trans        &trans  &trans
&trans  &trans  &trans          &kp UP_ARROW    &trans           &trans                  &kp COMMA   &kp N7  &kp N8  &kp N9        &trans  &trans
&trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans  &trans  &kp PERIOD  &kp N4  &kp N5  &kp NUMBER_6  &trans  &trans
&trans  &trans  &trans          &trans          &trans           &trans  &trans  &trans  &kp N0      &kp N1  &kp N2  &kp N3        &trans  &trans
&trans  &trans  &trans          &trans          &trans           &trans  &trans  &trans  &mo 5       &trans  &trans  &trans        &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans       &trans       &trans         &trans           &trans                  &trans          &trans     &trans                &trans                 &trans         &trans
&trans  &trans       &trans       &kp HASH       &trans           &trans                  &trans          &trans     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans         &trans
&trans  &kp PERCENT  &kp AT_SIGN  &kp QUESTION   &kp EXCLAMATION  &trans  &trans  &trans  &kp MINUS       &kp EQUAL  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp BACKSLASH  &kp GRAVE
&trans  &kp DOLLAR   &kp CARET    &kp AMPERSAND  &kp ASTERISK     &trans  &trans  &trans  &kp UNDERSCORE  &kp PLUS   &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PIPE       &kp TILDE
&trans  &trans       &trans       &trans         &trans           &mo 5   &trans  &trans  &trans          &trans     &trans                &trans                 &trans         &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &kp F10  &kp F11  &kp F12  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &kp F7   &kp F8   &kp F9   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F4   &kp F5   &kp F6   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F1   &kp F2   &kp F3   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans   &trans  &trans
            >;
        };
    };
};
